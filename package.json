{
  "name": "school-management-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm --workspace=@school/shared run db:generate",
    "db:push": "npm --workspace=@school/shared run db:push"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
