# Railway Backend Environment Variables Example

# Server Port
PORT=5000

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgres://username:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secrets (Generate 32+ character random strings)
JWT_SECRET=super-secret-jwt-key-replace-with-random-uuid
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-with-random-uuid

# Brevo (Sendinblue) Transactional Email 2FA API
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-email@school.co.ke

# Africa's Talking SMS API (Sandbox or Production)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=atsk_your-africas-talking-api-key-here
