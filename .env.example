# School Management System — Root Environment Reference
# Copy the appropriate file to apps/api/.env and apps/web/.env

# Backend (apps/api/.env)

# Port
PORT=5000

# Database Connection (Neon Cloud or local Docker)
# Local Docker: postgres://postgres:postgres@localhost:5432/school_sms?sslmode=disable
# Neon Cloud:   postgres://<username>:<password>@<ep-pooler>.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_sms?sslmode=disable

# Authentication Secrets (generate secure 32+ character random strings)
# You can use mailpit to receive the specific codes instead of using an actual email. (Yes, it runs locally)
JWT_SECRET=development_super_secret_jwt_key
JWT_REFRESH_SECRET=development_super_secret_refresh_key

# Email Service (Brevo / Sendinblue) - Optional in local development
BREVO_API_KEY=xkeysib-development-placeholder-key
BREVO_SENDER_EMAIL=admin@school.local

# SMS Service (Africa's Talking) - Optional in local development / Sandbox
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=atsk_sandbox_development_key

# Frontend (apps/web/.env)

# API Server URL
VITE_API_URL=http://localhost:5000
